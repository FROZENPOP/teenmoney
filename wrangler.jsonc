{
  "name": "teenmoney",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Files in public/ are served first; anything else (POST /api/sessions) reaches worker/index.js.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teenmoney",
      // Replaced with the real id at first deploy. Local dev does not use it.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}

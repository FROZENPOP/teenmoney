{
  "name": "teenmoney",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Files in public/ are served first; anything else (POST /api/sessions) reaches worker/index.js.
  "assets": { "directory": "./public" },
  // Per-visitor cap on saves. The key is the connecting IP, used only for counting; it is never stored or logged.
  "ratelimits": [
    { "name": "SAVE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teenmoney",
      "database_id": "4eab6fab-9269-4a65-9afc-a3a21fd67528"
    }
  ]
}
